# Build scratch: the vendored CLI source used only to cross-compile the linux
# binary. Not committed — regenerate with vendor-cli.sh.
cli-src/
# Windows-built binaries — local only.
*.exe
bin/server*
# The linux CLI binary IS committed (Render needs it in the build context):
#   bin/scientific-consensus-pp-cli-linux   <- intentionally NOT ignored
.DS_Store
PROMPT.md
# Serena's per-project data folder (semantic code agent, dev tool only).
# It writes its own .gitignore inside, which hides the contents but not the
# folder itself — so it kept showing as untracked in git status.
.serena/